# Vercel environment variables for the hosted dashboard.
# Set these in the Vercel dashboard (Project → Settings → Environment Variables)
# or with: vercel env add <NAME> production
# Local runs (python3 -m http.server) don't use these — the PIN gate only runs on Vercel.

# The team's 6-digit PIN typed at the gate.
ACCESS_CODE=123456

# A long random string used to sign session cookies (>= 16 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# A second 6-digit code that unlocks CSV exports for 8 hours.
EXPORT_CODE=654321
