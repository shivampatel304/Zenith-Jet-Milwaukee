# Vercel environment variables for the hosted dashboard.
# Local runs (python3 -m http.server) do not use these.

# The team access code typed at the gate.
ACCESS_CODE=123456

# A long random string used to sign session cookies (>= 16 chars).
SESSION_SECRET=change-me-to-a-long-random-string

# A second code that unlocks CSV exports for 8 hours.
EXPORT_CODE=654321
